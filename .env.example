# Solo demostración local: reemplazar por un secreto aleatorio de al menos 32 bytes.
JWT_SECRET=demo-local-cambiar-por-un-secreto-aleatorio-32-bytes

# --- Pasarela de pago (servicio Pagos) ---
# simulada (defecto, sin internet: la demo de fallas no depende de la red) | webpay
PASARELA=simulada
# Solo Webpay Plus en INTEGRACIÓN. Dejar vacíos para usar las credenciales públicas
# de integración del SDK oficial (no son secretos de producción).
TBK_ENV=integracion
TBK_COMMERCE_CODE=
TBK_API_KEY=
TBK_TIMEOUT_S=8
# Obligatoria con PASARELA=webpay: URL pública del túnel hacia el gateway.
# PAGOS_RETURN_URL=https://<subdominio>.ngrok-free.app/pagos/retorno
PAGOS_RETURN_URL=
# Orquestador: tiempo para pagar y timeout hacia Pagos (con webpay usar > TBK_TIMEOUT_S, p. ej. 10).
PAGO_TIMEOUT_S=300
PAGOS_TIMEOUT_S=
